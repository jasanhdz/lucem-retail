E2E_DATABASE_USER=lucem_e2e
E2E_ADMIN_PASSWORD=replace-with-a-long-random-password
E2E_SELLER_PASSWORD=replace-with-a-long-random-password
E2E_INVENTORY_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-different-long-random-secret
