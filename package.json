{
  "name": "lucem-retail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:prepare": "tsx scripts/e2e/prepare.ts",
    "e2e:cleanup": "tsx scripts/e2e/cleanup.ts",
    "test:e2e:auth": "playwright test --config=playwright.e2e.config.ts",
    "test:e2e:onboarding": "playwright test --config=playwright.onboarding.config.ts",
    "test:e2e:dev-09": "playwright test --config=playwright.dev-09.config.ts",
    "test:e2e:dev-10": "playwright test --config=playwright.dev-10.config.ts",
    "test:e2e:security": "playwright test --config=playwright.security.config.ts",
    "test:e2e:products": "playwright test --config=playwright.products.config.ts",
    "test:e2e:inventory": "playwright test --config=playwright.inventory.config.ts",
    "test:e2e:pos": "playwright test --config=playwright.pos.config.ts",
    "test:e2e:reservations": "playwright test --config=playwright.reservations.config.ts",
    "test:e2e:returns": "playwright test --config=playwright.returns.config.ts",
    "test:e2e:visual": "playwright test --config=playwright.e2e.config.ts e2e/dev-test-01/visual.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:install": "bash scripts/install-lucem-seed-demo"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.65.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.3.0",
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
