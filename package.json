{
  "name": "lucem-retail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:env:init": "node scripts/e2e/env.cjs init",
    "e2e:env:check": "node scripts/e2e/env.cjs check",
    "e2e:db:up": "bash scripts/e2e/provision-db.sh up",
    "e2e:db:restart-check": "bash scripts/e2e/provision-db.sh restart-check",
    "e2e:verify": "node scripts/e2e/env.cjs run verify",
    "e2e:diagnose-dashboard": "node scripts/e2e/env.cjs run diagnose-dashboard",
    "e2e:build:security": "node scripts/e2e/env.cjs run build:security",
    "test:e2e": "node scripts/e2e/env.cjs run playwright",
    "e2e:prepare": "node scripts/e2e/env.cjs run prepare",
    "e2e:cleanup": "node scripts/e2e/env.cjs run cleanup",
    "test:e2e:auth": "node scripts/e2e/env.cjs run playwright --config=playwright.e2e.config.ts",
    "test:e2e:onboarding": "node scripts/e2e/env.cjs run playwright --config=playwright.onboarding.config.ts",
    "test:e2e:dev-09": "node scripts/e2e/env.cjs run playwright --config=playwright.dev-09.config.ts",
    "test:e2e:dev-10": "node scripts/e2e/env.cjs run playwright --config=playwright.dev-10.config.ts",
    "test:e2e:security": "node scripts/e2e/env.cjs run playwright --config=playwright.security.config.ts",
    "test:e2e:products": "node scripts/e2e/env.cjs run playwright --config=playwright.products.config.ts",
    "test:e2e:products:ordering": "node scripts/e2e/env.cjs run ordering:5",
    "test:e2e:inventory": "node scripts/e2e/env.cjs run playwright --config=playwright.inventory.config.ts",
    "test:e2e:pos": "node scripts/e2e/env.cjs run playwright --config=playwright.pos.config.ts",
    "test:e2e:reservations": "node scripts/e2e/env.cjs run playwright --config=playwright.reservations.config.ts",
    "test:e2e:returns": "node scripts/e2e/env.cjs run playwright --config=playwright.returns.config.ts",
    "test:e2e:visual": "node scripts/e2e/env.cjs run playwright --config=playwright.e2e.config.ts e2e/dev-test-01/visual.spec.ts",
    "test:e2e:dev-11r-products": "node scripts/e2e/env.cjs run playwright --config=playwright.dev-11r-products.config.ts",
    "qa:audit": "node scripts/qa/bin.cjs",
    "qa:coverage": "node scripts/qa/bin.cjs --coverage",
    "qa:prepare": "node scripts/qa/bin.cjs --prepare",
    "qa:cleanup": "node scripts/qa/bin.cjs --cleanup",
    "qa:quick": "node scripts/qa/bin.cjs --quick",
    "qa:full": "node scripts/qa/bin.cjs --full",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:install": "bash scripts/install-lucem-seed-demo"
  },
  "bin": {
    "lucem-audit": "scripts/qa/bin.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.65.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/yauzl": "^3.4.0",
    "archiver": "^8.0.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.3.0",
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "yauzl": "^3.4.0"
  }
}
